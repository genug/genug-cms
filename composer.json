{
    "name": "genug/genug-cms",
    "license": "MIT",
    "authors": [
        {
            "name": "David Schwarz"
        }
    ],
    "require": {
        "php": "8.5.*",
        "monolog/monolog": "^3.10",
        "symfony/yaml": "^8.1",
        "psr/log": "^3.0",
        "thecodingmachine/safe": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "genug\\": "src/"
        }
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.95",
        "phpstan/phpstan": "^2.2",
        "thecodingmachine/phpstan-safe-rule": "^1.4"
    },
    "scripts": {
        "fix": "php-cs-fixer fix",
        "analyse": [
            "@analyse:phpstan"
        ],
        "analyse:phpstan": "phpstan analyse"
    }
}
